# --------------------------------------------------------------------------------------
__pycache__/
*.py[cod]
.venv/
venv/
.python-version
build/
dist/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

