# --------------------------------------------------------------------------------------
# Editors / OS
# --------------------------------------------------------------------------------------
.DS_Store
.idea/
.vscode/
*.swp
*~

# --------------------------------------------------------------------------------------
# Secrets and local-only state — never commit these
# --------------------------------------------------------------------------------------
.env
.env.*
*.local.json
/scratch/
/tmp/
/.tmp/

# --------------------------------------------------------------------------------------
# Python
# --------------------------------------------------------------------------------------
__pycache__/
*.py[cod]
.venv/
venv/
.python-version
build/
dist/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# --------------------------------------------------------------------------------------
# Node
# --------------------------------------------------------------------------------------
node_modules/
npm-debug.log*
yarn-error.log*
.next/
.turbo/

# --------------------------------------------------------------------------------------
# M0 pilot
# --------------------------------------------------------------------------------------
/data/
/site/

# IMDb bulk dumps: ~2GB and not ours to redistribute. Keep them outside the
# repo entirely; scripts/build_imdb_graph.py takes --dumps or CELEB_IMDB_DIR.
*.tsv.gz
*.tsv

# --------------------------------------------------------------------------------------
# Local agent + deploy state — carries machine and account detail, never commit
# --------------------------------------------------------------------------------------
# wrangler caches the Cloudflare account it authenticated as, including the
# account id and the account NAME, which is the operator's email address.
# Untracked is not the same as unignorable: this was one `git add` away from a
# public repository.
.wrangler/

# Overnight-run bookkeeping and hypothesis's example database. Both already
# carry a nested .gitignore; naming them here too means deleting that nested
# file cannot silently make them committable.
.overnight/
.hypothesis/
