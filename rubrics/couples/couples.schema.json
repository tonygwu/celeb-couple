{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "couples-in-a-film",
  "type": "object",
  "required": ["pairs"],
  "additionalProperties": false,
  "properties": {
    "pairs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["a", "b", "characters", "weight", "in_billed_list", "confidence"],
        "additionalProperties": false,
        "properties": {
          "a": {"type": "string", "minLength": 1},
          "b": {"type": "string", "minLength": 1},
          "characters": {"type": "string"},
          "weight": {"enum": ["central", "substantial", "incidental"]},
          "in_billed_list": {"type": "boolean"},
          "confidence": {"enum": ["high", "medium", "low"]}
        }
      }
    },
    "note": {"type": "string"}
  }
}
